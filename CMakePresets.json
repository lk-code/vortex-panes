{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "x86",
      "displayName": "x86 (Win32)",
      "inherits": "base",
      "architecture": { "value": "Win32", "strategy": "set" }
    },
    {
      "name": "x64",
      "displayName": "x64",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "arm64",
      "displayName": "ARM64",
      "inherits": "base",
      "architecture": { "value": "ARM64", "strategy": "set" }
    }
  ],
  "buildPresets": [
    { "name": "x86-debug", "configurePreset": "x86", "configuration": "Debug" },
    { "name": "x86-release", "configurePreset": "x86", "configuration": "Release" },
    { "name": "x64-debug", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64", "configuration": "Release" },
    { "name": "arm64-debug", "configurePreset": "arm64", "configuration": "Debug" },
    { "name": "arm64-release", "configurePreset": "arm64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "x86-debug", "inherits": "test-base", "configurePreset": "x86" },
    { "name": "x64-debug", "inherits": "test-base", "configurePreset": "x64" },
    { "name": "arm64-debug", "inherits": "test-base", "configurePreset": "arm64" }
  ]
}
