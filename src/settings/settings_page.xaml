<!--
  Settings window content, loaded at run time with XamlReader::Load (embedded as RCDATA).
  Contains no texts: the code sets them from the STRINGTABLE and finds elements by x:Name.
  Only theme resources are used, so light, dark and high contrast themes work.
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root">
  <Grid.Resources>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinHeight" Value="64"/>
    </Style>
    <Style x:Key="CardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
  </Grid.Resources>

  <ScrollViewer>
    <!-- Page container; a NavigationView with further pages follows in later milestones. -->
    <StackPanel x:Name="InfoPage" Padding="36,32,36,36" Spacing="4" MaxWidth="1000">
      <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,28">
        <Image x:Name="AppIcon" Width="64" Height="64"/>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="AppName" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"/>
        </StackPanel>
      </StackPanel>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="DeveloperLabel" Style="{StaticResource CardLabelStyle}"/>
          <TextBlock x:Name="DeveloperValue" Grid.Column="1" VerticalAlignment="Center"
                     IsTextSelectionEnabled="True"/>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="WebsiteLabel" Style="{StaticResource CardLabelStyle}"/>
          <HyperlinkButton x:Name="WebsiteLink" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LicensesLabel" Style="{StaticResource CardLabelStyle}"/>
          <HyperlinkButton x:Name="LicensesLink" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
